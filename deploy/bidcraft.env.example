# /etc/bidcraft/bidcraft.env  (chmod 600, owner root:bidcraft)
# Shared by the .NET API (keys with __) and the Python services (plain keys).

# ---- database (peer authentication over the local socket; no password) ----
ConnectionStrings__Default=Host=/var/run/postgresql;Database=bidcraft;Username=bidcraft
DATABASE_URL=dbname=bidcraft user=bidcraft host=/var/run/postgresql

# ---- files ----
Files__Root=/srv/bidcraft/files
FILES_ROOT=/srv/bidcraft/files

# ---- internal link between the API and the AI service (generate: openssl rand -hex 32) ----
Ai__BaseUrl=http://127.0.0.1:8001
Ai__InternalToken=change-me
AI_INTERNAL_TOKEN=change-me

# ---- API. The admin account is created on first start if no users exist ----
ASPNETCORE_URLS=http://127.0.0.1:5080
Jwt__Key=change-me-to-at-least-32-random-characters
Jwt__Hours=10
Admin__Email=admin@example.com
Admin__Password=change-me-now
Admin__Name=Administrator

# ---- external model (the only outbound connection). OPENAI_MODEL: any current model with structured outputs ----
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1
# OPENAI_BASE_URL=                       # leave empty for api.openai.com

# ---- redaction vault encryption key (generate: openssl rand -hex 32). Losing it makes stored token maps unreadable. ----
VAULT_KEY=change-me

# ---- company details used on the cover page, letterhead and seal ----
COMPANY_NAME=Uneecops Technologies Limited
COMPANY_CITY=New Delhi
COMPANY_CIN=U74899DL1995PLC073288

# ---- local processing ----
EMBED_MODEL=BAAI/bge-small-en-v1.5
EMBED_CACHE=/opt/bidcraft/models
OCR_ENABLED=true
OCR_LANGUAGES=eng+hin
POLICY_PATH=/opt/bidcraft/ai-service/config/redaction_policy.yaml
# SIGNATURE_FONT=/opt/bidcraft/fonts/GreatVibes-Regular.ttf   # optional script font for typed signatures
# SIGN_P12_PATH=/etc/bidcraft/org-signing.p12                 # optional organisational signing certificate
# SIGN_P12_PASSWORD=
